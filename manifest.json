{
  "manifest_version": 3,
  "name": "AetherFetch – Temporary Inbox",
  "description": "Create a temporary email address and read verification codes and links in a popup.",
  "version": "2.0.1",
  "permissions": ["storage"],
  "host_permissions": ["https://aetherfetch.vercel.app/*"],
  "action": {
    "default_title": "AetherFetch inbox",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@aetherfetch.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["personallyIdentifyingInfo", "authenticationInfo", "personalCommunications"] }
    }
  }
}
